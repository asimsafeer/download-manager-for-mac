{
  "name": "download-manager-for-mac",
  "version": "0.1.1",
  "description": "A macOS download manager with segmented transfers and browser video capture",
  "main": "desktop/main.cjs",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/asimsafeer/download-manager-for-mac.git" },
  "bugs": { "url": "https://github.com/asimsafeer/download-manager-for-mac/issues" },
  "author": "asimsafeer",
  "license": "Apache-2.0 AND MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs integration/*.test.cjs extension/*.test.cjs",
    "package": "npm run prepare:licenses && electron-builder --mac dir",
    "fetch:ytdlp": "node scripts/fetch-yt-dlp.mjs",
    "prepare:licenses": "node scripts/write-ffmpeg-info.mjs",
    "icons": "bash scripts/build-icons.sh",
    "package:extension": "bash scripts/package-extension.sh",
    "dist": "npm run fetch:ytdlp && npm run prepare:licenses && electron-builder --mac dmg --publish never",
    "dist:zip": "npm run fetch:ytdlp && npm run prepare:licenses && electron-builder --mac zip --publish never",
    "dist:x64": "npm run fetch:ytdlp && npm run prepare:licenses && electron-builder --mac dmg zip --x64 --publish never",
    "dist:arm64": "npm run fetch:ytdlp && npm run prepare:licenses && electron-builder --mac dmg zip --arm64 --publish never",
    "verify:arch": "bash scripts/verify-bundle-arch.sh"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.2"
  },
  "build": {
    "appId": "com.asimsafeer.downloadmanagerformac",
    "productName": "Download Manager for Mac",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "renderer/**/*",
      "assets/**/*",
      "integration/**/*",
      "extension/**/*",
      "THIRD-PARTY.md",
      "LICENSE",
      "LICENSE-UPSTREAM-MIT",
      "NOTICE",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      { "from": "node_modules/ffmpeg-static/LICENSE", "to": "licenses/ffmpeg-static-LICENSE.txt" },
      { "from": "node_modules/googlevideo/LICENSE", "to": "licenses/googlevideo-LICENSE.txt" },
      { "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE", "to": "licenses/ffmpeg-licensing-note.txt" },
      { "from": "build/ffmpeg-build-info.txt", "to": "licenses/ffmpeg-build-info.txt" },
      { "from": "vendor/yt-dlp", "to": "tools/yt-dlp" },
      {
        "from": "vendor",
        "to": "tools",
        "filter": [
          "LICENSE.txt",
          "THIRD_PARTY_LICENSES.txt",
          "!yt-dlp/**"
        ]
      },
      {
        "from": "extension",
        "to": "browser/extension",
        "filter": [
          "**/*",
          "!*.test.cjs"
        ]
      },
      {
        "from": "integration",
        "to": "browser/integration",
        "filter": [
          "native-host.sh",
          "native-host.cjs",
          "README.md",
          "register-native-host.sh"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Download-Manager-for-Mac-${version}-macOS-${arch}.${ext}",
      "signIgnore": ["Contents/Resources/tools/yt-dlp/"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "title": "Download Manager for Mac",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "^5.0.1"
  }
}
